# ==============================================================================
# PORTFOLIO ENVIRONMENT VARIABLES
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env.local' (for local Next.js development) or '.env'
# 2. Fill in the values for the services you want to use.
# 3. Do NOT commit your actual .env or .env.local file to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI & LLM PROVIDERS
# ------------------------------------------------------------------------------
# OpenAI API Key (Used by /api/chat fallback and /api/ask)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Hugging Face API Key (Used for embeddings in RAG and text generation fallback)
# Get from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# Optional: Override Hugging Face text model for /api/chat
# Default candidates are 'HuggingFaceH4/zephyr-7b-beta' and 'mistralai/Mistral-7B-Instruct-v0.2'
# HF_TEXT_MODEL=HuggingFaceH4/zephyr-7b-beta

# ------------------------------------------------------------------------------
# 2. VECTOR DATABASE (PINECONE)
# ------------------------------------------------------------------------------
# Used for RAG personal context retrieval in /api/chat, /api/ask, and scripts
# Get from: https://app.pinecone.io
PINECONE_API_KEY=p≈
PINECONE_ENVIRONMENT=us-east1-gcp
PINECONE_INDEX_NAME=Gireesh-AI

# Optional: Supabase public/signed URL to the JSON file with biographical data (used by scripts/uploadToPinecone.js)
SUPABASE_JSON_URL=

# ------------------------------------------------------------------------------
# 3. DATABASE (SUPABASE)
# ------------------------------------------------------------------------------
# Required for OTP verification and storing resume requests
# Get from: Supabase Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# IMPORTANT: Service Role Key is required (bypasses RLS on server routes)
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 4. EMAIL / OTP SERVICE (Choose either Resend OR SMTP)
# ------------------------------------------------------------------------------
# Sender address shown to users
EMAIL_FROM=Gireesh <no-reply@yourdomain.com>

# Option A: Resend (Recommended for Next.js / Vercel)
# Get from: https://resend.com/api-keys
RESEND_API_KEY=

# Option B: SMTP (e.g. Gmail App Password or custom mail server)
# Only needed if RESEND_API_KEY is not provided
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
