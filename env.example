# ==============================================================================
# PORTFOLIO ENVIRONMENT VARIABLES
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env.local' (for local Next.js development) or '.env'
# 2. Fill in the values for the services you want to use.
# 3. Do NOT commit your actual .env or .env.local file to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI PROVIDER
# ------------------------------------------------------------------------------
# OpenAI API Key (used by /api/chat and /api/ask)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Pinecone integrated embedding index; keep values server-side.
PINECONE_API_KEY=
PINECONE_HOST=
PINECONE_INDEX_NAME=


# ------------------------------------------------------------------------------
# 2. DATABASE (SUPABASE)
# ------------------------------------------------------------------------------
# Required for OTP, resume requests, and approved public portfolio context for AI chat
# Get from: Supabase Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# IMPORTANT: Service Role Key is required (bypasses RLS on server routes)
SUPABASE_SERVICE_ROLE_KEY=

# Anonymous chat trials
# Generate a long random secret for hashing trial identifiers (falls back to the service-role key if unset).
TRIAL_SESSION_SECRET=

# MongoDB Atlas connection string for private chatbot transcript storage.
# Keep server-side; never use a NEXT_PUBLIC_ variable.
MONGODB_URI=
# Optional database/collection overrides (defaults: portfolio database, chats collection)
MONGODB_DATABASE=
MONGODB_CHAT_COLLECTION=

# ------------------------------------------------------------------------------
# 4. EMAIL / OTP SERVICE (Choose either Resend OR SMTP)
# ------------------------------------------------------------------------------
# Sender address shown to users
EMAIL_FROM=Gireesh <no-reply@yourdomain.com>

# Option A: Resend (Recommended for Next.js / Vercel)
# Get from: https://resend.com/api-keys
RESEND_API_KEY=

# Option B: SMTP (e.g. Gmail App Password or custom mail server)
# Only needed if RESEND_API_KEY is not provided
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
