# ==============================================================================
# PORTFOLIO ENVIRONMENT VARIABLES
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env.local' (for local Next.js development) or '.env'
# 2. Fill in the values for the services you want to use.
# 3. Do NOT commit your actual .env or .env.local file to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI PROVIDER
# ------------------------------------------------------------------------------
# OpenAI API Key (used by /api/chat and /api/ask)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Pinecone integrated embedding index; keep values server-side.
PINECONE_API_KEY=
PINECONE_HOST=
PINECONE_INDEX_NAME=

# ------------------------------------------------------------------------------
# 2. DATABASE (SUPABASE)
# ------------------------------------------------------------------------------
# Required for OTP, resume requests, and approved public portfolio context for AI chat
# Get from: Supabase Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# IMPORTANT: Service Role Key is required (bypasses RLS on server routes)
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 3. CHAT TRANSCRIPT STORAGE (MONGODB)
# ------------------------------------------------------------------------------
# Server-side MongoDB connection string; never prefix this with NEXT_PUBLIC_.
MONGODB_URI=
# Optional database and collection overrides. Defaults: portfolio / chats.
MONGODB_DATABASE=portfolio
MONGODB_CHAT_COLLECTION=chats

# ------------------------------------------------------------------------------
# 4. EMAIL / OTP SERVICE (Choose either Resend OR Gmail / SMTP)
# ------------------------------------------------------------------------------
# In local development only, missing providers return the temporary OTP in the
# verification UI. OTPs are never written to application logs.

# Sender address shown to users
# (Note: For Resend free accounts without custom domain, use: onboarding@resend.dev)
EMAIL_FROM="Gireesh Portfolio" <onboarding@resend.dev>

# Option A: Resend (Recommended for Next.js / Vercel)
# 1. Sign up free at https://resend.com
# 2. Get API key from https://resend.com/api-keys
RESEND_API_KEY=
# Optional signed event webhook secret. Set this when you register
# https://your-domain/api/webhooks/resend in the Resend dashboard.
RESEND_WEBHOOK_SECRET=

# Option B: Gmail SMTP
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Paste your gmail and the 16-character password below (without spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_SECURE=false

# ------------------------------------------------------------------------------
# 5. PRIVATE ACTIVITY MONITORING
# ------------------------------------------------------------------------------
# Comma-separated email addresses allowed to open /admin/gireesh-activity. These users
# must first sign in through the existing OTP flow. Configure this on the server
# only; do not prefix with NEXT_PUBLIC_.
MONITORING_ADMIN_EMAILS=
# Optional dedicated HMAC secret for OTP digests and rate-limit keys. Keep stable
# across deployments. If omitted, SUPABASE_SERVICE_ROLE_KEY is used.
OTP_HASH_SECRET=
