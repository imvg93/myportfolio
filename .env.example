# ==============================================================================
# PORTFOLIO ENVIRONMENT VARIABLES
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env.local' (for local Next.js development) or '.env'
# 2. Fill in the values for the services you want to use.
# 3. Do NOT commit your actual .env or .env.local file to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI PROVIDER
# ------------------------------------------------------------------------------
# OpenAI API Key (used by /api/chat and /api/ask)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 2. DATABASE (SUPABASE)
# ------------------------------------------------------------------------------
# Required for OTP, resume requests, and approved public portfolio context for AI chat
# Get from: Supabase Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# IMPORTANT: Service Role Key is required (bypasses RLS on server routes)
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 4. EMAIL / OTP SERVICE (Choose either Resend OR Gmail / SMTP)
# ------------------------------------------------------------------------------
# If neither is configured, the app runs in Dev Mode and logs OTP codes directly
# to the terminal console and UI for instant local testing!

# Sender address shown to users
# (Note: For Resend free accounts without custom domain, use: onboarding@resend.dev)
EMAIL_FROM="Gireesh Portfolio" <onboarding@resend.dev>

# Option A: Resend (Recommended for Next.js / Vercel)
# 1. Sign up free at https://resend.com
# 2. Get API key from https://resend.com/api-keys
RESEND_API_KEY=

# Option B: Gmail SMTP
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Paste your gmail and the 16-character password below (without spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_SECURE=false
